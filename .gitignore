#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/.gradle/
/android/app/.cxx/

# iOS/CocoaPods (generated on the Mac when building there)
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.podspec

# Widget Preview related
.widget_preview/

# Environment / secrets — never commit real Supabase keys.
# NOTE: this repo is public. .env ships inside the APK as a Flutter asset,
# so it must only ever hold the Supabase URL + anon key (both safe to
# distribute, since RLS is what actually guards the data). Deploy-time
# credentials — access tokens, API keys, the service-role key — belong in
# .secrets/, which is never bundled and never committed.
.env
.secrets/

# Supabase CLI scratch files
supabase/.temp/
