# Copy this file to .env and fill in your Supabase project's values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to ship in a client app; access is enforced by
# Row Level Security policies (see supabase/migrations/0001_init_schema.sql).

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
